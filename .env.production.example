# Production environment for docker-compose.prod.yml (names only - no real values belong in git).
# Copy to .env.production on the server, fill in, then: chmod 600 .env.production
# Generate secrets on the server, e.g.: openssl rand -hex 32 (keys) / openssl rand -hex 24 (passwords).
# Use hex (URL-safe) passwords: they are embedded in connection URLs by the compose file.
# Keep a copy of this file in the team password manager: backups deliberately do not contain it.

# --- app ---
# Public address users open (https required for a public domain); also used in invite links
PUBLIC_URL=
# Label shown in logs (production | staging)
APP_ENV=production
# 1 = anyone can create an organization from the sign-in page; 0 = operators create them (npm run bootstrap)
ALLOW_SIGNUP=0

# --- reverse proxy / TLS (Caddy) ---
# Host name Caddy serves, e.g. app.example.com
SITE_ADDRESS=
# ACME e-mail (Let's Encrypt), or "/certs/origin.pem /certs/origin.key" (Cloudflare Origin CA), or "internal" (drills)
CADDY_TLS=
# Cloudflare IP ranges (space separated, https://www.cloudflare.com/ips/) when the DNS record is proxied; else leave empty
CADDY_TRUSTED_PROXIES=
# Directory holding origin.pem/origin.key when CADDY_TLS uses them (default ./deploy/certs)
CADDY_CERTS_DIR=
HSTS=
HTTP_PORT=
HTTPS_PORT=

# --- database (PostgreSQL 18 container, private network only) ---
# Superuser (local socket inside the db container only)
POSTGRES_PASSWORD=
# taskapp_owner: migrations, backups (bypasses row-level security)
PG_OWNER_PASSWORD=
# taskapp: API + worker, subject to row-level tenant isolation
PG_APP_PASSWORD=
# Optional tuning (defaults sized for a 4-8 GB server)
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_CONNECTIONS=
DB_MEM_LIMIT=

# --- cache ---
# (none: the product uses no Redis/cache service)

# --- mail ---
# (none yet: no e-mail provider is integrated; invite links are copied from the admin screen)

# --- payments ---
# (none: the product takes no payments)

# --- AI (optional, disabled when empty; external Anthropic API, no local model) ---
ANTHROPIC_API_KEY=
AI_MODEL=

# --- storage ---
# Private files live in the "storage" Docker volume (STORAGE_DIR=/data/storage inside the containers)
# Backups: local directory, retention, and optional off-server copies
BACKUP_DIR=
BACKUP_RETENTION_DAYS=
# e.g. backup@backup-host:/srv/backups/taskapp (rsync over SSH with a key)
BACKUP_RSYNC_TARGET=
# Path to a chmod-600 file with RESTIC_REPOSITORY, RESTIC_PASSWORD_FILE and storage credentials
RESTIC_ENV_FILE=

# --- analytics ---
# (none: product analytics are computed in-app from the database)

# --- auth ---
# 32-byte hex key encrypting MFA and integration secrets at rest. Losing it makes those unreadable: back it up.
APP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=
# Sign-in attempts per IP per minute
LOGIN_RATE_LIMIT=
# Optional: dedicated low-privilege account the post-deploy smoke test signs in with
SMOKE_ORG=
SMOKE_EMAIL=
SMOKE_PASSWORD=

# --- error tracking ---
# (none integrated: structured JSON logs to stdout, rotated by Docker; see docs/deployment-audit/07_DOCKER_PRODUCTION_PLAN.md)

# --- third-party APIs ---
# (none required; calendar/ICS and webhook integrations are configured per organization in the app)

# --- runtime sizing (optional) ---
API_MEM_LIMIT=
API_HEAP_MB=
API_CPUS=
API_PG_POOL_MAX=
WORKER_MEM_LIMIT=
WORKER_HEAP_MB=
WORKER_CPUS=
WORKER_PG_POOL_MAX=

# --- image source (optional) ---
# Pull CI-built images from a registry instead of building on the server
IMAGE_REGISTRY=
