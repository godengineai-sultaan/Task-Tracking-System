{
  "name": "task-tracking-productivity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Task Tracking and Productivity — My Day, quick capture, board/list, recaps, individual analytics and Admin Daily Routine.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:init": "bash scripts/db.sh init",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:migrate": "tsx server/src/cli/migrate.ts",
    "db:seed": "tsx server/src/cli/seed.ts",
    "bootstrap": "tsx server/src/cli/bootstrap.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/src/main.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@tanstack/react-query": "^5.104.0",
    "cmdk": "^1.1.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "luxon": "^3.7.2",
    "node-ical": "^0.27.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
